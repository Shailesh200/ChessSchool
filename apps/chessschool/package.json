{
  "name": "chessschool",
  "version": "0.4.0",
  "private": true,
  "engines": { "node": "22.x" },
  "main": "expo-router/entry",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "build:android:prod": "npx eas-cli build --platform android --profile production --non-interactive",
    "submit:android:internal": "npx eas-cli submit --platform android --profile production --non-interactive --latest",
    "build:ios:prod": "npx eas-cli build --platform ios --profile production --non-interactive",
    "e2e:android": "bash scripts/phase1-android.sh"
  },
  "dependencies": {
    "@chessschool/chess": "workspace:*",
    "@chessschool/design": "workspace:*",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "babel-preset-expo": "~54.0.11",
    "expo": "~54.0.37",
    "expo-alternate-app-icons": "^11.0.0",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
