{
  "expo": {
    "name": "ChessSchool",
    "slug": "chess-school",
    "owner": "shaileshjha200",
    "version": "0.7.0",
    "description": "A few calm minutes a day to get better at chess.",
    "orientation": "portrait",
    "scheme": "chessschool",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://api.chess-school.in/ota/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/ota-signing.crt",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.chessschool.app",
      "buildNumber": "29",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:chess-school.in",
        "applinks:www.chess-school.in"
      ]
    },
    "android": {
      "package": "com.chessschool.app",
      "versionCode": 48,
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFE9DC"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chess-school.in",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "chess-school.in",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "chess-school.in",
              "pathPrefix": "/mate/"
            },
            {
              "scheme": "https",
              "host": "chess-school.in",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "www.chess-school.in",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "www.chess-school.in",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "www.chess-school.in",
              "pathPrefix": "/mate/"
            },
            {
              "scheme": "https",
              "host": "www.chess-school.in",
              "pathPrefix": "/i/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-updates",
      [
        "@sentry/react-native/expo",
        {
          "organization": "shailesh-jha",
          "project": "chessschool-mobile",
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ChessSchool opens the photo you choose to read a chess position in it (that photo is not stored), or to use it as your profile picture.",
          "cameraPermission": "ChessSchool uses the camera to photograph a chess board so it can read the position, or to take your profile picture."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#5B5BD6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFF6EE",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#14152B"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true,
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1055675597789-3uqou6qfqg76e033tpulbkjgee059o54"
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "IconClassroom",
            "ios": "./assets/app-icons/classroom.png",
            "android": {
              "foregroundImage": "./assets/app-icons/classroom-fg.png",
              "backgroundImage": "./assets/app-icons/classroom-bg.png",
              "backgroundColor": "#FFE9DC"
            }
          },
          {
            "name": "IconNight",
            "ios": "./assets/app-icons/night.png",
            "android": {
              "foregroundImage": "./assets/app-icons/night-fg.png",
              "backgroundImage": "./assets/app-icons/night-bg.png",
              "backgroundColor": "#14152B"
            }
          },
          {
            "name": "IconGarden",
            "ios": "./assets/app-icons/garden.png",
            "android": {
              "foregroundImage": "./assets/app-icons/garden-fg.png",
              "backgroundImage": "./assets/app-icons/garden-bg.png",
              "backgroundColor": "#2F7D5B"
            }
          },
          {
            "name": "IconSunset",
            "ios": "./assets/app-icons/sunset.png",
            "android": {
              "foregroundImage": "./assets/app-icons/sunset-fg.png",
              "backgroundImage": "./assets/app-icons/sunset-bg.png",
              "backgroundColor": "#F59E5B"
            }
          },
          {
            "name": "IconOcean",
            "ios": "./assets/app-icons/ocean.png",
            "android": {
              "foregroundImage": "./assets/app-icons/ocean-fg.png",
              "backgroundImage": "./assets/app-icons/ocean-bg.png",
              "backgroundColor": "#117A8C"
            }
          },
          {
            "name": "IconMidnight",
            "ios": "./assets/app-icons/midnight.png",
            "android": {
              "foregroundImage": "./assets/app-icons/midnight-fg.png",
              "backgroundImage": "./assets/app-icons/midnight-bg.png",
              "backgroundColor": "#0B0B12"
            }
          },
          {
            "name": "IconLibrary",
            "ios": "./assets/app-icons/library.png",
            "android": {
              "foregroundImage": "./assets/app-icons/library-fg.png",
              "backgroundImage": "./assets/app-icons/library-bg.png",
              "backgroundColor": "#6B3F1F"
            }
          },
          {
            "name": "IconPixel",
            "ios": "./assets/app-icons/pixel.png",
            "android": {
              "foregroundImage": "./assets/app-icons/pixel-fg.png",
              "backgroundImage": "./assets/app-icons/pixel-bg.png",
              "backgroundColor": "#6C4BD8"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af6d1946-9dd2-42ef-b2a3-ad71bfbb7854"
      }
    }
  }
}
