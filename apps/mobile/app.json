{
  "expo": {
    "name": "ChessSchool",
    "slug": "chess-school",
    "version": "0.2.0",
    "description": "A premium chess-learning school — graduate through classes, puzzles, and matches.",
    "orientation": "portrait",
    "scheme": "chessschool",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/af6d1946-9dd2-42ef-b2a3-ad71bfbb7854"
    },
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbfaff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chessschool.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chessschool.app",
      "versionCode": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5b5bd6"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#fbfaff",
      "themeColor": "#5b5bd6"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false
        }
      ],
      "./plugins/withRemoveExpoAudioForegroundServices.js",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#fbfaff",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1c1b2e"
          }
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://us.sentry.io/",
          "organization": "shailesh-jha",
          "project": "chessschool-mobile",
          "note": "Use SENTRY_AUTH_TOKEN env for source maps; local builds set SENTRY_DISABLE_AUTO_UPLOAD=true"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af6d1946-9dd2-42ef-b2a3-ad71bfbb7854"
      }
    },
    "owner": "shaileshjha200"
  }
}
