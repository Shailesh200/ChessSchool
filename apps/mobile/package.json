{
  "name": "mobile",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "generate:pieces": "node scripts/generate-piece-assets.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "doctor": "npx expo-doctor",
    "release:check": "pnpm typecheck && pnpm test && pnpm doctor",
    "build:android:apk": "bash scripts/build-android-apk.sh",
    "build:android:preview": "npx eas-cli build --platform android --profile preview --non-interactive",
    "build:android:prod": "npx eas-cli build --platform android --profile production --non-interactive",
    "build:android:prod:local": "mkdir -p dist && EAS_BUILD_NO_EXPO_GO_WARNING=true npx eas-cli build --platform android --profile production --local --non-interactive --output dist/chessschool-release.aab",
    "submit:android:internal": "npx eas-cli submit --platform android --profile production --non-interactive --latest",
    "submit:android:internal:local": "npx eas-cli submit --platform android --profile production --path dist/chessschool-release.aab",
    "submit:android:store": "npx eas-cli submit --platform android --profile play-store --non-interactive --latest",
    "update:preview": "npx eas-cli update --channel preview",
    "update:production": "npx eas-cli update --channel production",
    "eas:init": "npx eas-cli init && npx eas-cli update:configure"
  },
  "dependencies": {
    "@chess-school/core": "workspace:*",
    "@chess-school/progression": "workspace:*",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@sentry/react-native": "~7.2.0",
    "ably": "^2.23.0",
    "babel-preset-expo": "~54.0.11",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "^7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.0",
    "expo-crypto": "^15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "~14.0.8",
    "expo-speech": "^14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.0",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "^15.0.11",
    "lottie-react-native": "~7.3.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/bottom-tabs"
      ]
    }
  }
}
