# ChessSchool Mobile — copy to `.env` and fill in values.
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app bundle.

# Production API (local dev: http://localhost:3210 for parity / http://localhost:3000 for web dev)
EXPO_PUBLIC_API_URL=https://chess-school.in

# Google OAuth — Web client ID (same project as chess-school.in)
# Used as webClientId for native Google Sign-In token exchange.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# iOS OAuth client (Application type: iOS, bundle com.chessschool.app)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android OAuth client (Application type: Android, package com.chessschool.app + SHA-1)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
