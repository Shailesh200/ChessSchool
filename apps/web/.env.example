# ChessSchool Web — copy to `.env.local` and fill in values.

# Database (local: file:local.db — remote: libsql://…)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Google OAuth (Web application client — sign-in redirect flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Native mobile ID token verification — must match EAS / mobile .env
# Add the Android + iOS client IDs from Google Cloud Console.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional: Ably realtime (online PvP push). Without it, clients fall back to polling.
ABLY_API_KEY=

# Coach TTS — optional Google Cloud TTS (defaults to Edge TTS if unset)
# GOOGLE_TTS_CREDENTIALS={"client_email":"…","private_key":"…"}
# TTS_PROVIDER=google

# App URL for OAuth redirects (production: https://chess-school.in)
NEXT_PUBLIC_APP_URL=https://chess-school.in

# Sentry error monitoring (optional — leave unset to disable)
# NEXT_PUBLIC_SENTRY_DSN=https://…@….ingest.sentry.io/…
# SENTRY_DSN=https://…@….ingest.sentry.io/…   # server/edge; falls back to NEXT_PUBLIC_
# SENTRY_AUTH_TOKEN=                           # source map upload at build time
