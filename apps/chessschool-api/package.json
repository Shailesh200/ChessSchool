{
  "name": "chessschool-api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:vercel": "node scripts/build-vercel.mjs",
    "qa:serve": "tsx scripts/qa-serve.ts",
