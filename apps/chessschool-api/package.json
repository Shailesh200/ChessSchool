    "@libsql/client": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.9.0",
    "hono": "^4.10.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9"
  }
