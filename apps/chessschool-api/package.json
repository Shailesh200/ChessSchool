{
  "name": "chessschool-api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:vercel": "node scripts/build-vercel.mjs",
    "qa:serve": "tsx scripts/qa-serve.ts",
    "qa:delete-accounts": "tsx scripts/delete-qa-accounts.ts",
    "seed:puzzles": "tsx scripts/seed-puzzles.ts",
    "seed:course": "tsx scripts/seed-course.ts",
    "build:practice": "node scripts/build-practice-lessons.mjs",
    "voice:build": "tsx scripts/voice-build.ts",
    "voice:migrate": "tsx scripts/voice-migrate.ts",
    "db:restore-check": "tsx scripts/db-restore-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@chessschool/chess": "workspace:*",
    "@chessschool/design": "workspace:*",
    "@hono/node-server": "^1.19.5",
    "@libsql/client": "^0.17.4",
    "@resvg/resvg-wasm": "2.6.2",
    "@sentry/node": "10.66.0",
    "bcryptjs": "^3.0.3",
    "chess.js": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.9.0",
    "harfbuzzjs": "0.4.15",
    "hono": "^4.10.4",
    "ota-server": "workspace:*",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@types/node": "^22",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9"
  }
}
