{
  "name": "chess-school",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "pnpm --filter web e2e",
    "format": "prettier --write .",
    "web": "pnpm --filter web",
    "mobile": "pnpm --filter mobile",
    "mobile:release:check": "pnpm --filter mobile release:check",
    "verify:milestone": "bash scripts/verify-milestone.sh",
    "verify:seed": "node scripts/verify-seed-artifact.mjs",
    "verify:web": "bash scripts/verify-web-seo.sh && bash scripts/verify-web-lighthouse.sh",
    "verify:web-seo": "bash scripts/verify-web-seo.sh",
    "verify:web-lighthouse": "bash scripts/verify-web-lighthouse.sh",
    "verify:e2e-routes": "node scripts/verify-e2e-route-coverage.mjs",
    "verify:parity": "node scripts/verify-parity-coverage.mjs",
    "parity:generate": "node scripts/generate-parity-maestro.mjs",
    "parity:seed": "node scripts/parity-seed.mjs",
    "parity:compare": "node scripts/parity-compare.mjs",
    "parity:ios": "bash scripts/parity-ios.sh",
    "parity:android": "bash scripts/parity-android.sh",
    "parity:semantic": "pnpm --filter web exec playwright test e2e/parity-matrix.spec.ts",
    "verify:coverage": "bash scripts/verify-test-coverage.sh",
    "db:seed:test-user": "pnpm --filter web db:seed:test-user",
    "puzzle-school": "node packages/puzzle-school/cli/puzzle-school.mjs",
    "puzzle-school:validate": "node packages/puzzle-school/cli/puzzle-school.mjs validate",
    "release:gates": "bash scripts/release/run-all.sh \"$(git rev-parse HEAD)\"",
    "release:deps": "bash scripts/release/deps-gate.sh",
    "release:secrets": "bash scripts/release/secrets-scan.sh",
    "test:release-gates": "pnpm --filter web exec vitest run --config vitest.release-gates.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^12.8.2",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.35.2",
    "turbo": "^2.5.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "axios": "1.20.0",
      "follow-redirects": "1.16.2",
      "nanoid": "3.3.18",
      "postcss": "8.5.18",
      "browserslist": "4.28.7",
      "source-map-js": "1.2.2",
      "sharp": "0.35.5",
      "zod": "4.6.6",
      "brace-expansion@1.1.15": "1.1.20",
      "brace-expansion@1.1.16": "1.1.20",
      "brace-expansion@1.1.18": "1.1.20",
      "brace-expansion@2.1.1": "2.1.6",
      "brace-expansion@2.1.2": "2.1.6",
      "brace-expansion@2.1.4": "2.1.6",
      "brace-expansion@5.0.6": "5.0.11",
      "brace-expansion@5.0.7": "5.0.11",
      "brace-expansion@5.0.9": "5.0.11"
    }
  }
}
